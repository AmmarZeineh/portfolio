# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for metadata, sitemap, OG images). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by maintenance scripts, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: email notifications for contact form messages (https://resend.com)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=ammarzeineh3@gmail.com
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional: phone push for contact form messages via a Telegram bot.
# Create a bot with @BotFather (gives the token), send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
